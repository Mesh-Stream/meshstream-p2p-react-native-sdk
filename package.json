{
  "name": "react-native-meshstream",
  "version": "1.0.0",
  "description": "MeshStream P2P playback URL SDK for React Native",
  "main": "lib/typescript/index.js",
  "module": "lib/typescript/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/src",
    "ios",
    "react-native.config.js",
    "tests/ios",
    "MeshStreamP2P.podspec",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify:version": "node scripts/verify-package-version.mjs",
    "test:ios": "node --test tests/node/ios-regression-guards.test.mjs",
    "verify:ios": "npm run test:ios && node scripts/verify-ios-package.mjs && node scripts/verify-ios-xctest.mjs",
    "verify:ios:public": "npm run test:ios && node scripts/verify-ios-package.mjs && node scripts/verify-ios-xctest.mjs --repo-update",
    "prepare": "npm run build",
    "prepack": "npm run verify:version"
  },
  "keywords": [
    "react-native",
    "p2p",
    "cdn",
    "video",
    "meshstream"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mesh-Stream/meshstream-p2p-react-native-sdk.git"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react-native": "^0.76.0",
    "typescript": "^5.6.3"
  }
}
